#include <stdio.h>
long long calls;
int digital_root(long long n){ if(n<0)n=-n; if(n<10)return (int)n; long long s=0; while(n){s+=n%10;n/=10;} return digital_root(s); }
long long power_linear(long long b,int e){calls++; if(e==0)return 1; return b*power_linear(b,e-1);}
long long power_fast(long long b,int e){calls++; if(e==0)return 1; long long h=power_fast(b,e/2),r=h*h; if(e%2)r*=b; return r;}
long long power_iterative(long long b,int e){long long r=1;while(e>0){if(e%2)r*=b;b*=b;e/=2;}return r;}
int main(void){printf("digital root(9875) = %d\n",digital_root(9875)); calls=0; long long a=power_linear(2,30); printf("linear: %lld in %lld calls\n",a,calls); calls=0; long long b=power_fast(2,30); printf("fast: %lld in %lld calls\n",b,calls); printf("iterative 2^30 = %lld\n",power_iterative(2,30)); int ns[]={10,100,1000,10000}; for(int i=0;i<4;i++){calls=0;power_linear(1,ns[i]);long long lc=calls;calls=0;power_fast(1,ns[i]);printf("n=%d linear_calls=%lld fast_calls=%lld\n",ns[i],lc,calls);}return 0;}
